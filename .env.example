# Vanta Paper Trader — Hostinger deployment
# Set these in Hostinger hPanel Environment Variables. Never commit real values.

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Cron job authentication
CRON_SECRET=

# Application URL
APP_URL=https://

# Next.js private loopback port (not exposed publicly)
NEXT_PORT=3001

# CORS for API agents
CORS_ORIGIN=https://

# Allowed origins for Next.js server actions (comma-separated)
ALLOWED_ORIGINS=localhost:3000,https://

# Google OAuth (for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
